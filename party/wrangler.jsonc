// Cloudflare Worker config for the quiz server (PartyServer on Durable Objects).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wmg-quiz",
  "main": "worker.ts",
  "compatibility_date": "2026-10-13",

  // `wrangler dev` listens on the LAN too, so phones can test against a local
  // server (src/config.js points http:// pages at <same host>:8787).
  "dev": { "ip": "0.0.0.0", "port": 8787 },

  // Workers Logs: requests, console output and uncaught errors are kept and
  // searchable under Workers & Pages → wmg-quiz → Logs in the dashboard.
  "observability": { "enabled": true },

  // One Durable Object per quiz room. The binding name `Main` is what
  // routePartykitRequest() exposes as /parties/main/<room>.
  "durable_objects": {
    "bindings": [{ "name": "Main", "class_name": "Main" }]
  },

  // Wrangler never writes these for you: add a new entry whenever a Durable
  // Object class is added, renamed or removed. SQLite storage is required on
  // the Workers free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Main"] }]
}
